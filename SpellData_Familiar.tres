[sub_resource type="Resource" id="Variant_dog"]
script = ExtResource("4_variant")
Id = "familiar_dog"
DisplayName = "Hound Familiar"
ShortName = "Dog"
Description = "A hound of your own light runs at your heel. It goes for whatever gets closest to you - leaps on it and bites - and snatches enemy bolts out of the air before they reach you. A second hound joins at level 3."
Traits = "Most damage a bite   Range: guards what nears you   Shields you: catches bolts"
Icon = ExtResource("5_dog")
CountNoun = "Hounds"
BaseDamage = 16
BaseCooldown = 1.0
BaseProjectileCount = 1
BaseRange = 200.0
LevelUpgrades = Array[ExtResource("2")]([SubResource("Resource_dog_2"), SubResource("Resource_dog_3"), SubResource("Resource_dog_4"), SubResource("Resource_dog_5"), SubResource("Resource_dog_6"), SubResource("Resource_dog_7"), SubResource("Resource_dog_8")])

; --- THE CROW: the fastest. It flies - over water, walls and the crowd - ranges half again as far as a
; hound, goes for whatever shoots first, stoops, pecks and rises off, and is on the next quarry before a
; hound has turned. Less in a peck than a hound puts in a bite, and a shorter cooldown. One crow; the
; second joins at level 3. Level 8: 37 a peck every 0.39 s from two crows, hunting 375 round him. (It was
; 9 + 2 a level, 24 at level 8, until 2026-10-31: since then it patrols a ring round him between dives and
; climbs and rises round every peck, which cost a third of its pecks - 254 a second at level 8 with Raven
; and the Morrigan against 380 - so a peck is half again what it was: 416 a second at level 8 now.)

